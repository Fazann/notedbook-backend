ENVIRONMENT=local
PORT=3010

JWT_SECRET=
# access token lifetime in hours, refresh token lifetime in days
ACC_TK_EXPIRED=
REF_TK_EXPIRED=

DB_USERNAME=
DB_PASSWORD=
DB_NAME=
DB_HOST=
DB_PORT=5432
# defaults to require; set disable for a local DB without SSL, verify-full to also check the certificate
DB_SSLMODE=require
DB_TIMEZONE=UTC


REDIS_ADDR=l
REDIS_PASSWORD=
REDIS_DB=
# true for managed Redis that requires TLS (Upstash, Redis Cloud, ElastiCache with in-transit encryption)
REDIS_TLS=false

S3_BUCKET=
S3_ID=
S3_SECRET=
S3_REGION=
S3_PREFIX_URL=
S3_PROJECT_NAME=x

SMTP_HOST=
# 587 uses STARTTLS, 465 uses implicit TLS
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Notebook

# secret for the AES-GCM password reset key; any long random string
OTP_SECRET=

# Browser origins allowed to call the API, comma-separated; empty allows every origin (local only).
# * matches any part without "/", e.g. Vercel previews: https://<project>-*-<team>.vercel.app
CORS_ALLOWED_ORIGINS=

# Proxies in front of the API that append to X-Forwarded-For (the client IP is that many entries from
# the right). Empty = 0 locally (TCP peer address) and 1 on Cloud Run (detected with K_SERVICE).
# Set 2 when a Google external load balancer sits in front of Cloud Run.
TRUSTED_PROXY_HOPS=

# Rate limits per route, in requests a minute. Each block doubles (1, 2, 4 ... min) up to
# RATE_LIMIT_MAX_BLOCK minutes, and the doubling resets after RATE_LIMIT_STRIKES_TTL minutes.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_IP=100
RATE_LIMIT_USER_READS=60
RATE_LIMIT_USER_WRITES=20
RATE_LIMIT_MAX_BLOCK=60
RATE_LIMIT_STRIKES_TTL=1440

# Daily exchange rates for GET /exchange-rates (cached in Redis, never stored in the database). Must return base USD.
EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest/USD
