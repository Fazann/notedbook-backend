ENVIRONMENT=local
PORT=3010

JWT_SECRET=
# access token lifetime in hours, refresh token lifetime in days
ACC_TK_EXPIRED=
REF_TK_EXPIRED=

DB_USERNAME=
DB_PASSWORD=
DB_NAME=
DB_HOST=
DB_PORT=5432
# defaults to require; set disable for a local DB without SSL, verify-full to also check the certificate
DB_SSLMODE=require
DB_TIMEZONE=UTC


REDIS_ADDR=l
REDIS_PASSWORD=
REDIS_DB=
# true for managed Redis that requires TLS (Upstash, Redis Cloud, ElastiCache with in-transit encryption)
REDIS_TLS=false

S3_BUCKET=
S3_ID=
S3_SECRET=
S3_REGION=
S3_PREFIX_URL=
S3_PROJECT_NAME=x

SMTP_HOST=
# 587 uses STARTTLS, 465 uses implicit TLS
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Notebook

# secret for the AES-GCM password reset key; any long random string
OTP_SECRET=
